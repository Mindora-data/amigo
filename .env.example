# Copy to .env.local and fill local secrets there. Do not commit .env.local.
NINO_LLM_PROVIDER=claude
NINO_CLAUDE_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# Optional: store the key in macOS Keychain instead of this file.
# NINO_KEYCHAIN_SERVICE=nino-anthropic

# Optional local overrides:
# NINO_PORT=8000
# NINO_SCHEDULER_INTERVAL=60
# NINO_DB_PATH=data/nino.db
# SSL_CERT_FILE=/etc/ssl/cert.pem
