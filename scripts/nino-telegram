#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NINO_ENV_FILE:-$ROOT_DIR/.env.local}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi
if [[ -z "${SSL_CERT_FILE:-}" && -f /etc/ssl/cert.pem ]]; then
  export SSL_CERT_FILE=/etc/ssl/cert.pem
fi
DEFAULT_PYTHON="$ROOT_DIR/.venv/bin/python"
if [[ -x "$DEFAULT_PYTHON" ]]; then
  PYTHON_BIN="${NINO_PYTHON:-$DEFAULT_PYTHON}"
else
  PYTHON_BIN="${NINO_PYTHON:-$(command -v python3)}"
fi
DB_PATH="${NINO_DB_PATH:-$ROOT_DIR/data/nino.db}"
HOST="${NINO_HOST:-127.0.0.1}"
PORT="${NINO_PORT:-8000}"
BASE_URL="${NINO_BASE_URL:-http://$HOST:$PORT}"

cd "$ROOT_DIR"
PYTHONPATH=src "$PYTHON_BIN" -m nino.telegram --db "$DB_PATH" --base-url "$BASE_URL" "$@"
