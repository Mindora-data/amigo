#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NINO_ENV_FILE:-$ROOT_DIR/.env.local}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi
PYTHON_BIN="${NINO_PYTHON:-$ROOT_DIR/.venv/bin/python}"

cd "$ROOT_DIR"
PYTHONPATH=src "$PYTHON_BIN" -m nino.claude_live "$@"
