memory_search() {
  local agent="nino"
  local memory_type="all"
  local scope="long"
  local json_output=false
  local query_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        agent="${2:-}"
        shift 2
        ;;
      --type)
        memory_type="${2:-}"
        shift 2
        ;;
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --json)
        json_output=true
        shift
        ;;
      --help|-h)
        echo "Usage: scripts/ninoctl memory-search [--agent nino] [--type all|cold|hot] [--scope recent|medium|long] [--json] <query>"
        return 0
        ;;
      *)
        query_parts+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$agent" || -z "$memory_type" || -z "$scope" || ${#query_parts[@]} -eq 0 ]]; then
    echo "Usage: scripts/ninoctl memory-search [--agent nino] [--type all|cold|hot] [--scope recent|medium|long] [--json] <query>" >&2
    return 2
  fi
  if [[ "$memory_type" != "all" && "$memory_type" != "cold" && "$memory_type" != "hot" ]]; then
    echo "--type must be all, cold or hot." >&2
    return 2
  fi

  local query body
  query="${query_parts[*]}"
  body="{\"query_intent\":$(json_string "$query"),\"time_scope\":$(json_string "$scope"),\"memory_type_filter\":$(json_string "$memory_type")}"
  local response
  response="$(curl -fsS -X POST "$BASE_URL/agents/$agent/memory/search" -H "Content-Type: application/json" -d "$body")"
  if [[ "$json_output" == true ]]; then
    printf '%s\n' "$response"
    return 0
  fi
  "$PYTHON_BIN" -c '
import json
import sys

payload = json.load(sys.stdin)
counts = payload.get("memory_type_counts", {})
visible = payload.get("visible_memory_type_counts", {})
visible_candidates = payload.get("visible_candidates", 0)
total = counts.get("total", 0)
cold_visible = visible.get("cold", 0)
cold_total = counts.get("cold", 0)
hot_visible = visible.get("hot", 0)
hot_total = counts.get("hot", 0)
active_filter = payload.get("memory_type_filter", "all")
print(
    f"memory: {visible_candidates}/{total} "
    f"(cold {cold_visible}/{cold_total}, "
    f"hot {hot_visible}/{hot_total}, "
    f"filter {active_filter})"
)
for candidate in payload.get("memory_candidates", []):
    score = float(candidate.get("score", 0.0))
    confidence = float(candidate.get("confidence", 0.0))
    memory_type = candidate.get("memory_type", "hot")
    statement = candidate.get("statement", "")
    source = candidate.get("source_episode_id", "")
    print(f"- [{memory_type}] {statement}")
    print(f"  score={score:.3f} confidence={confidence:.3f} source={source}")
' <<< "$response"
}

memory_facts() {
  local agent="nino"
  local status_filter="active"
  local key_filter=""
  local json_output=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        agent="${2:-}"
        shift 2
        ;;
      --status)
        status_filter="${2:-}"
        shift 2
        ;;
      --key)
        key_filter="${2:-}"
        shift 2
        ;;
      --json)
        json_output=true
        shift
        ;;
      --help|-h)
        echo "Usage: scripts/ninoctl memory-facts [--agent nino] [--status active|inactive|all] [--key preference] [--json]"
        return 0
        ;;
      *)
        echo "Unknown memory-facts argument: $1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "$agent" || ( "$status_filter" != "active" && "$status_filter" != "inactive" && "$status_filter" != "all" ) ]]; then
    echo "Usage: scripts/ninoctl memory-facts [--agent nino] [--status active|inactive|all] [--key preference] [--json]" >&2
    return 2
  fi

  local path="/agents/$agent/memory/facts?status=$status_filter"
  if [[ -n "$key_filter" ]]; then
    path="${path}&key=$key_filter"
  fi
  local response
  response="$(curl -fsS "$BASE_URL$path")"
  if [[ "$json_output" == true ]]; then
    printf '%s\n' "$response"
    return 0
  fi
  "$PYTHON_BIN" -c '
import json
import sys

payload = json.load(sys.stdin)
status_filter = sys.argv[1]
key_filter = sys.argv[2]
facts = payload.get("facts", [])
counts = payload.get("fact_counts", {})
total_count = counts.get("total", len(facts))
active_count = counts.get("active", 0)
inactive_count = counts.get("inactive", 0)
if status_filter == "active":
    facts = [fact for fact in facts if not fact.get("valid_to")]
elif status_filter == "inactive":
    facts = [fact for fact in facts if fact.get("valid_to")]
if key_filter:
    facts = [fact for fact in facts if fact.get("key") == key_filter]

print(
    f"cold memory facts: {len(facts)} "
    f"({status_filter}, total {total_count}, "
    f"active {active_count}, inactive {inactive_count})"
)
if key_filter:
    print(f"key filter: {key_filter}")
for fact in facts:
    status = "inactive" if fact.get("valid_to") else "active"
    source = fact.get("source_episode_id", "")
    confidence = float(fact.get("confidence", 0.0))
    key = fact.get("key", "")
    value = fact.get("value", "")
    print(f"- [{status}] {key}: {value}")
    print(f"  confidence={confidence:.3f} source={source}")
' "$status_filter" "$key_filter" <<< "$response"
}

command="${1:-}"
shift || true

case "$command" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) status ;;
  health) request "/health" ;;
  wait-health) wait_health "${1:-120}" ;;
  deep-health) request "/health/deep" ;;
  mode) request "/operations/mode" ;;
  claude) request "/operations/claude" ;;
  configure-claude) configure_claude "$@" ;;
  configure-deepseek) configure_deepseek "$@" ;;
  configure-password) configure_password "$@" ;;
  disable-claude) disable_claude "$@" ;;
  agents) request "/agents" ;;
  snapshot) request "/development/snapshot" ;;
  doctor) doctor ;;
  readiness) readiness ;;
  audit) product_audit ;;
  server-audit) server_audit ;;
  persistent-audit) persistent_audit ;;
  live-audit) live_audit ;;
  final-preflight) final_preflight ;;
  final-audit) final_audit ;;
  finish) finish "$@" ;;
  sync-runtime) sync_runtime "$@" ;;
  product-status) product_status "$@" ;;
  next-action) product_status --next-action ;;
  completion-audit) completion_audit "$@" ;;
  closing-report) closing_report "$@" ;;
  prod-smoke) prod_smoke "$@" ;;
  telegram) telegram_bot "$@" ;;
  telegram-launchd) telegram_launchd "$@" ;;
  telegram-style-import) telegram_style_import "$@" ;;
  synthetic-companion) synthetic_companion "$@" ;;
  reports) reports ;;
  report) report "${1:-}" ;;
  eval) eval_local "$@" ;;
  memory-search) memory_search "$@" ;;
  memory-facts) memory_facts "$@" ;;
  logs) logs "${1:-}" ;;
  backup) backup ;;
  backups) backups ;;
  restore) restore "${1:-}" ;;
  -h|--help|help|"") usage ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
