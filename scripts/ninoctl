#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NINO_ENV_FILE:-$ROOT_DIR/.env.local}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi
if [[ -z "${SSL_CERT_FILE:-}" && -f /etc/ssl/cert.pem ]]; then
  export SSL_CERT_FILE=/etc/ssl/cert.pem
fi
DATA_DIR="${NINO_DATA_DIR:-$ROOT_DIR/data}"
DB_PATH="${NINO_DB_PATH:-$DATA_DIR/nino.db}"
HOST="${NINO_HOST:-127.0.0.1}"
PORT="${NINO_PORT:-8000}"
SCHEDULER_INTERVAL="${NINO_SCHEDULER_INTERVAL:-60}"
PID_FILE="${NINO_PID_FILE:-$DATA_DIR/nino.pid}"
LOG_FILE="${NINO_LOG_FILE:-$DATA_DIR/nino-server.log}"
LAUNCHD_LABEL="${NINO_LAUNCHD_LABEL:-local.nino.server}"
LAUNCHD_LOG_FILE="${NINO_LAUNCHD_LOG_FILE:-$DATA_DIR/nino-launchd.log}"
LAUNCHD_ERR_FILE="${NINO_LAUNCHD_ERR_FILE:-$DATA_DIR/nino-launchd.err.log}"
BACKUP_DIR="${NINO_BACKUP_DIR:-$DATA_DIR/backups}"
REPORT_DIR="${NINO_REPORT_DIR:-$DATA_DIR/reports}"
DEFAULT_PYTHON="$ROOT_DIR/.venv/bin/python"
if [[ -x "$DEFAULT_PYTHON" ]]; then
  PYTHON_BIN="${NINO_PYTHON:-$DEFAULT_PYTHON}"
else
  PYTHON_BIN="${NINO_PYTHON:-$(command -v python3)}"
fi
BASE_URL="http://$HOST:$PORT"
HEALTH_ERROR=""

usage() {
  cat <<EOF
Usage: scripts/ninoctl <command>

Commands:
  start       Start the NIÑO server in the background.
  stop        Stop the background server started by ninoctl.
  restart     Stop and start the server.
  status      Show process and health status.
  health      Request GET /health.
  wait-health Wait until GET /health responds or timeout is reached.
  deep-health Request GET /health/deep.
  mode        Request GET /operations/mode.
  claude      Show LLM configuration status without sending a prompt.
  configure-claude Configure Claude in .env.local or macOS Keychain.
  configure-deepseek Configure DeepSeek in .env.local.
  configure-password Configure the single-user password hash in .env.local.
  disable-claude Remove Claude settings from .env.local and optionally Keychain.
  agents      Request GET /agents.
  snapshot    Request GET /development/snapshot.
  doctor      Run health, agents, snapshot and nino LLM status checks.
  readiness   Run tests, smoke and local product audit.
  audit       Run local product audit without requiring a running server.
  server-audit Run product audit against the configured local server.
  persistent-audit Run product audit requiring the macOS launchd service.
  live-audit  Run product audit requiring a live Claude key.
  final-preflight Run final local preflight without a live Claude call.
  final-audit Run product audit requiring launchd and live Claude.
  finish      Configure Claude, restart launchd, audit, write evidence and audit completion.
              Use --key-env when ANTHROPIC_API_KEY is already exported.
              Use --skip-configure when Claude is already configured.
  sync-runtime Pull, reinstall if needed and close against the official runtime.
  product-status Summarize final readiness, evaluation and blockers.
  next-action Print only the recommended next command.
  completion-audit Audit every completion requirement and remaining blockers.
  closing-report Write a JSON evidence report for the current product state.
  prod-smoke Run production-mode auth smoke without exposing the server.
  telegram Run Telegram long-polling bot or create link code.
  telegram-launchd Manage Telegram long-polling service with launchd.
  telegram-style-import Import Telegram JSON into an offline anonymous style corpus.
  synthetic-companion Run synthetic longitudinal companion regression.
  reports     List local closing evidence reports.
  report      Print one closing evidence report. Use: scripts/ninoctl report <nino-closing-*.json|latest>
  eval        Run deterministic local regression evaluations.
  memory-search Search agent memory. Use: scripts/ninoctl memory-search [--agent nino] [--type all|cold|hot] <query>
  memory-facts List cold memory facts. Use: scripts/ninoctl memory-facts [--agent nino] [--status active|inactive|all]
  logs        Show recent logs. Use: scripts/ninoctl logs -f
  backup      Create a timestamped SQLite backup.
  backups     List local SQLite backups.
  restore     Restore a SQLite backup. Use: scripts/ninoctl restore <backup.db>

Environment overrides:
  NINO_ENV_FILE, NINO_HOST, NINO_PORT, NINO_DB_PATH, NINO_SCHEDULER_INTERVAL, NINO_PYTHON
  NINO_LLM_PROVIDER, NINO_CLAUDE_MODEL, ANTHROPIC_API_KEY, NINO_DEEPSEEK_API_KEY
  NINO_RUNTIME_DIR for sync-runtime; defaults to $HOME/Developer/amigo

Local env:
  By default scripts/ninoctl loads $ROOT_DIR/.env.local when it exists.
EOF
}

ensure_dirs() {
  mkdir -p "$DATA_DIR" "$BACKUP_DIR"
}

pid_is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
  pid_matches_current_server "$pid"
}

pid_matches_current_server() {
  local pid="$1"
  local command_line
  command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$command_line" == *"-m nino.server"* && "$command_line" == *"--db $DB_PATH"* && "$command_line" == *"--port $PORT"* ]]
}

discover_pid() {
  local matches
  matches="$(pgrep -f "[Pp]ython.*-m nino.server.*--db $DB_PATH.*--port $PORT" 2>/dev/null || true)"
  printf '%s\n' "$matches" | awk 'NF {print; exit}'
}

adopt_running_pid() {
  local pid
  pid="$(discover_pid)"
  if [[ -n "$pid" ]]; then
    echo "$pid" > "$PID_FILE"
    return 0
  fi
  return 1
}

server_responds() {
  local output rc
  output="$(curl -fsS "$BASE_URL/health" 2>&1 >/dev/null)" || {
    rc=$?
    HEALTH_ERROR="$(printf '%s' "$output" | tail -n 1)"
    return "$rc"
  }
  HEALTH_ERROR=""
  return 0
}

wait_health() {
  local timeout="${1:-120}"
  local elapsed=0
  if [[ ! "$timeout" =~ ^[0-9]+$ || "$timeout" -lt 1 ]]; then
    echo "Usage: scripts/ninoctl wait-health [timeout_seconds]" >&2
    return 2
  fi
  while [[ "$elapsed" -lt "$timeout" ]]; do
    if server_responds; then
      echo "health: ok at $BASE_URL"
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  if server_responds; then
    echo "health: ok at $BASE_URL"
    return 0
  fi
  echo "health: not responding at $BASE_URL after ${timeout}s$(health_error_suffix)" >&2
  return 1
}

health_error_suffix() {
  if [[ -n "${HEALTH_ERROR:-}" ]]; then
    printf ' (%s)' "$HEALTH_ERROR"
  fi
}

launchd_print() {
  command -v launchctl >/dev/null 2>&1 || return 1
  launchctl print "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null
}

launchd_pid() {
  launchd_print | awk -F '= ' '/^[[:space:]]*pid = / {print $2; exit}'
}

launchd_state() {
  launchd_print | awk -F '= ' '/^[[:space:]]*state = / {print $2; exit}'
}

launchd_root() {
  launchd_print | awk -F '= ' '/^[[:space:]]*working directory = / {print $2; exit}'
}

launchd_matches_root() {
  local service_root
  service_root="$(launchd_root || true)"
  [[ "$service_root" == "$ROOT_DIR" ]]
}

status_log_file() {
  if [[ -s "$LOG_FILE" || ! -e "$LAUNCHD_LOG_FILE" ]]; then
    echo "$LOG_FILE"
  elif ! launchd_matches_root; then
    echo "$LOG_FILE"
  else
    echo "$LAUNCHD_LOG_FILE"
  fi
}

start() {
  ensure_dirs
  if pid_is_running; then
    echo "NIÑO already running with pid $(cat "$PID_FILE")"
    return 0
  fi
  if server_responds; then
    if adopt_running_pid; then
      echo "NIÑO already responds at $BASE_URL; adopted pid $(cat "$PID_FILE")"
    else
      echo "NIÑO already responds at $BASE_URL, but pid file is not managed by ninoctl."
    fi
    return 0
  fi
  if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "Python executable not found: $PYTHON_BIN" >&2
    return 1
  fi

  cd "$ROOT_DIR"
  nohup env PYTHONPATH=src "$PYTHON_BIN" -m nino.server \
    --db "$DB_PATH" \
    --host "$HOST" \
    --port "$PORT" \
    --scheduler-interval "$SCHEDULER_INTERVAL" \
    >> "$LOG_FILE" 2>&1 &

  echo $! > "$PID_FILE"
  sleep 1

  if server_responds; then
    echo "NIÑO started at $BASE_URL with pid $(cat "$PID_FILE")"
    echo "Logs: $LOG_FILE"
    return 0
  fi

  echo "NIÑO did not respond after start. Check logs: $LOG_FILE" >&2
  return 1
}

stop() {
  if ! pid_is_running; then
    if server_responds && adopt_running_pid; then
      echo "Adopted running NIÑO pid $(cat "$PID_FILE") before stopping."
    else
      rm -f "$PID_FILE"
      echo "NIÑO is not running under ninoctl."
      return 0
    fi
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid"

  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "NIÑO stopped."
      return 0
    fi
    sleep 0.2
  done

  echo "NIÑO did not stop gracefully; pid $pid is still running." >&2
  return 1
}

status() {
  if ! pid_is_running && server_responds; then
    adopt_running_pid || true
  fi

  local service_pid service_state
  if launchd_matches_root; then
    service_pid="$(launchd_pid || true)"
    service_state="$(launchd_state || true)"
  else
    service_pid=""
    service_state=""
  fi

  if pid_is_running; then
    echo "process: running, pid $(cat "$PID_FILE")"
  elif [[ -n "$service_pid" ]]; then
    echo "process: running via launchd, pid $service_pid"
  else
    echo "process: not running under ninoctl"
  fi
  if [[ -n "$service_state" ]]; then
    echo "launchd: $service_state ($LAUNCHD_LABEL)"
  fi

  if server_responds; then
    echo "health: ok at $BASE_URL"
  else
    echo "health: not responding at $BASE_URL$(health_error_suffix)"
  fi

  echo "db: $DB_PATH"
  echo "log: $(status_log_file)"
  if [[ -e "$LAUNCHD_ERR_FILE" ]]; then
    echo "launchd_err: $LAUNCHD_ERR_FILE"
  fi
}

request() {
  local path="$1"
  curl -fsS "$BASE_URL$path"
  echo
}

json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  printf '"%s"' "$value"
}

post_json() {
  local path="$1"
  local body="$2"
  curl -fsS -X POST "$BASE_URL$path" -H "Content-Type: application/json" -d "$body"
  echo
}

configure_claude() {
  "$ROOT_DIR/scripts/nino-configure-claude" "$@"
}

configure_deepseek() {
  "$ROOT_DIR/scripts/nino-configure-deepseek" "$@"
}

configure_password() {
  "$ROOT_DIR/scripts/nino-configure-password" "$@"
}

disable_claude() {
  "$ROOT_DIR/scripts/nino-disable-claude" "$@"
}

logs() {
  ensure_dirs
  local target_log
  target_log="$(status_log_file)"
  touch "$target_log"
  if [[ "${1:-}" == "-f" ]]; then
    tail -f "$target_log"
  else
    tail -80 "$target_log"
  fi
}

backup() {
  ensure_dirs
  if [[ ! -f "$DB_PATH" ]]; then
    echo "Database not found: $DB_PATH" >&2
    return 1
  fi

  local stamp backup_path
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_path="$BACKUP_DIR/nino-$stamp.db"

  if command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "$DB_PATH" ".backup '$backup_path'"
  else
    cp "$DB_PATH" "$backup_path"
  fi

  echo "Backup created: $backup_path"
}

backups() {
  ensure_dirs
  find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.db' -print | sort
}

reports() {
  mkdir -p "$REPORT_DIR"
  find "$REPORT_DIR" -maxdepth 1 -type f -name 'nino-closing-*.json' -print | sort
}

report() {
  local report_name="${1:-}"
  if [[ -z "$report_name" ]]; then
    echo "Usage: scripts/ninoctl report <nino-closing-*.json|latest>" >&2
    return 2
  fi
  mkdir -p "$REPORT_DIR"
  if [[ "$report_name" == "latest" ]]; then
    local latest_path
    latest_path="$(find "$REPORT_DIR" -maxdepth 1 -type f -name 'nino-closing-*.json' -print | sort | tail -n 1)"
    if [[ -z "$latest_path" ]]; then
      echo "No closing reports found in: $REPORT_DIR" >&2
      return 1
    fi
    report_name="$(basename "$latest_path")"
  fi
  if [[ "$report_name" == */* || ! "$report_name" =~ ^nino-closing-[0-9]{8}-[0-9]{6}[.]json$ ]]; then
    echo "Invalid report name: $report_name" >&2
    return 2
  fi

  local report_path="$REPORT_DIR/$report_name"
  if [[ ! -f "$report_path" ]]; then
    echo "Report not found: $report_path" >&2
    return 1
  fi
  cat "$report_path"
  echo
}

restore() {
  local source_path="${1:-}"
  if [[ -z "$source_path" ]]; then
    echo "Usage: scripts/ninoctl restore <backup.db>" >&2
    return 2
  fi
  if [[ ! -f "$source_path" ]]; then
    echo "Backup not found: $source_path" >&2
    return 1
  fi
  if pid_is_running || server_responds; then
    echo "Stop NIÑO before restoring a database." >&2
    return 1
  fi

  ensure_dirs
  if [[ -f "$DB_PATH" ]]; then
    local stamp pre_restore
    stamp="$(date +%Y%m%d-%H%M%S)"
    pre_restore="$BACKUP_DIR/pre-restore-$stamp.db"
    cp "$DB_PATH" "$pre_restore"
    echo "Current database saved: $pre_restore"
  fi
  cp "$source_path" "$DB_PATH"
  echo "Database restored from: $source_path"
}

doctor() {
  echo "== status =="
  status
  echo
  echo "== health =="
  request "/health" || true
  echo "== mode =="
  request "/operations/mode" || true
  echo "== claude =="
  request "/operations/claude" || true
  echo "== agents =="
  request "/agents" || true
  echo "== snapshot =="
  request "/development/snapshot" || true
  echo "== nino llm =="
  request "/agents/nino/llm/status" || true
}

readiness() {
  "$ROOT_DIR/scripts/nino-readiness"
}

product_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --skip-http --json
}

server_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --json
}

persistent_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-launchd --json
}

live_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-claude-live --json
}

final_preflight() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-launchd --require-claude-config --json
}

final_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-launchd --require-claude-config --require-claude-live --json
}

finish() {
  local preflight_only=false
  local use_default_keychain=true
  local skip_configure=false
  local key_env=false
  local configure_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip-configure)
        skip_configure=true
        shift
        ;;
      --key-env)
        key_env=true
        shift
        ;;
      --preflight-only)
        preflight_only=true
        shift
        ;;
      --no-keychain)
        use_default_keychain=false
        shift
        ;;
      --keychain-service)
        use_default_keychain=false
        configure_args+=("$1" "${2:-}")
        shift 2
        ;;
      *)
        configure_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ "$skip_configure" == true && ${#configure_args[@]} -gt 0 ]]; then
    echo "--skip-configure cannot be combined with Claude configuration arguments." >&2
    return 2
  fi
  if [[ "$skip_configure" == true && "$key_env" == true ]]; then
    echo "--skip-configure cannot be combined with --key-env." >&2
    return 2
  fi
  if [[ "$key_env" == true && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    echo "--key-env requires ANTHROPIC_API_KEY in the current environment." >&2
    return 2
  fi

  if [[ "$skip_configure" == true ]]; then
    if [[ "${NINO_LLM_PROVIDER:-}" != "claude" || ( -z "${ANTHROPIC_API_KEY:-}" && -z "${NINO_KEYCHAIN_SERVICE:-}" ) ]]; then
      echo "--skip-configure requires Claude to be configured in $ENV_FILE or the current environment." >&2
      echo "Use: printf '%s' \"\$ANTHROPIC_API_KEY\" | scripts/ninoctl finish --key-stdin" >&2
      return 2
    fi
  fi

  if [[ "$skip_configure" == false && "$use_default_keychain" == true ]]; then
    configure_args+=("--keychain-service" "nino-anthropic")
  fi

  if [[ "$skip_configure" == false ]]; then
    configure_claude "${configure_args[@]}"
  fi
  "$ROOT_DIR/scripts/nino-launchd" stop
  "$ROOT_DIR/scripts/nino-launchd" start
  wait_health 120
  product_status || true
  local audit_rc=0
  set +e
  if [[ "$preflight_only" == true ]]; then
    final_preflight
    audit_rc=$?
  else
    final_audit
    audit_rc=$?
  fi
  set -e
  closing_report --json || true
  completion_audit --json || true
  return "$audit_rc"
}

