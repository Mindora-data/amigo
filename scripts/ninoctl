#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NINO_ENV_FILE:-$ROOT_DIR/.env.local}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi
DATA_DIR="${NINO_DATA_DIR:-$ROOT_DIR/data}"
DB_PATH="${NINO_DB_PATH:-$DATA_DIR/nino.db}"
HOST="${NINO_HOST:-127.0.0.1}"
PORT="${NINO_PORT:-8000}"
SCHEDULER_INTERVAL="${NINO_SCHEDULER_INTERVAL:-60}"
PID_FILE="${NINO_PID_FILE:-$DATA_DIR/nino.pid}"
LOG_FILE="${NINO_LOG_FILE:-$DATA_DIR/nino-server.log}"
BACKUP_DIR="${NINO_BACKUP_DIR:-$DATA_DIR/backups}"
DEFAULT_PYTHON="$ROOT_DIR/.venv/bin/python"
if [[ -x "$DEFAULT_PYTHON" ]]; then
  PYTHON_BIN="${NINO_PYTHON:-$DEFAULT_PYTHON}"
else
  PYTHON_BIN="${NINO_PYTHON:-$(command -v python3)}"
fi
BASE_URL="http://$HOST:$PORT"

usage() {
  cat <<EOF
Usage: scripts/ninoctl <command>

Commands:
  start       Start the NIÑO server in the background.
  stop        Stop the background server started by ninoctl.
  restart     Stop and start the server.
  status      Show process and health status.
  health      Request GET /health.
  deep-health Request GET /health/deep.
  mode        Request GET /operations/mode.
  claude      Show Claude configuration status without sending a prompt.
  agents      Request GET /agents.
  snapshot    Request GET /development/snapshot.
  doctor      Run health, agents, snapshot and nino LLM status checks.
  readiness   Run tests, smoke and local product audit.
  audit       Run local product audit without requiring a running server.
  server-audit Run product audit against the configured local server.
  persistent-audit Run product audit requiring the macOS launchd service.
  live-audit  Run product audit requiring a live Claude key.
  logs        Show recent logs. Use: scripts/ninoctl logs -f
  backup      Create a timestamped SQLite backup.
  backups     List local SQLite backups.
  restore     Restore a SQLite backup. Use: scripts/ninoctl restore <backup.db>

Environment overrides:
  NINO_ENV_FILE, NINO_HOST, NINO_PORT, NINO_DB_PATH, NINO_SCHEDULER_INTERVAL, NINO_PYTHON
  NINO_LLM_PROVIDER, NINO_CLAUDE_MODEL, ANTHROPIC_API_KEY

Local env:
  By default scripts/ninoctl loads $ROOT_DIR/.env.local when it exists.
EOF
}

ensure_dirs() {
  mkdir -p "$DATA_DIR" "$BACKUP_DIR"
}

pid_is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

discover_pid() {
  pgrep -f "python.*-m nino.server.*--port $PORT" 2>/dev/null | head -n 1 || true
}

adopt_running_pid() {
  local pid
  pid="$(discover_pid)"
  if [[ -n "$pid" ]]; then
    echo "$pid" > "$PID_FILE"
    return 0
  fi
  return 1
}

server_responds() {
  curl -fsS "$BASE_URL/health" >/dev/null 2>&1
}

start() {
  ensure_dirs
  if pid_is_running; then
    echo "NIÑO already running with pid $(cat "$PID_FILE")"
    return 0
  fi
  if server_responds; then
    if adopt_running_pid; then
      echo "NIÑO already responds at $BASE_URL; adopted pid $(cat "$PID_FILE")"
    else
      echo "NIÑO already responds at $BASE_URL, but pid file is not managed by ninoctl."
    fi
    return 0
  fi
  if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "Python executable not found: $PYTHON_BIN" >&2
    return 1
  fi

  cd "$ROOT_DIR"
  nohup env PYTHONPATH=src "$PYTHON_BIN" -m nino.server \
    --db "$DB_PATH" \
    --host "$HOST" \
    --port "$PORT" \
    --scheduler-interval "$SCHEDULER_INTERVAL" \
    >> "$LOG_FILE" 2>&1 &

  echo $! > "$PID_FILE"
  sleep 1

  if server_responds; then
    echo "NIÑO started at $BASE_URL with pid $(cat "$PID_FILE")"
    echo "Logs: $LOG_FILE"
    return 0
  fi

  echo "NIÑO did not respond after start. Check logs: $LOG_FILE" >&2
  return 1
}

stop() {
  if ! pid_is_running; then
    if server_responds && adopt_running_pid; then
      echo "Adopted running NIÑO pid $(cat "$PID_FILE") before stopping."
    else
      rm -f "$PID_FILE"
      echo "NIÑO is not running under ninoctl."
      return 0
    fi
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid"

  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "NIÑO stopped."
      return 0
    fi
    sleep 0.2
  done

  echo "NIÑO did not stop gracefully; pid $pid is still running." >&2
  return 1
}

status() {
  if ! pid_is_running && server_responds; then
    adopt_running_pid || true
  fi

  if pid_is_running; then
    echo "process: running, pid $(cat "$PID_FILE")"
  else
    echo "process: not running under ninoctl"
  fi

  if server_responds; then
    echo "health: ok at $BASE_URL"
  else
    echo "health: not responding at $BASE_URL"
  fi

  echo "db: $DB_PATH"
  echo "log: $LOG_FILE"
}

request() {
  local path="$1"
  curl -fsS "$BASE_URL$path"
  echo
}

logs() {
  ensure_dirs
  touch "$LOG_FILE"
  if [[ "${1:-}" == "-f" ]]; then
    tail -f "$LOG_FILE"
  else
    tail -80 "$LOG_FILE"
  fi
}

backup() {
  ensure_dirs
  if [[ ! -f "$DB_PATH" ]]; then
    echo "Database not found: $DB_PATH" >&2
    return 1
  fi

  local stamp backup_path
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_path="$BACKUP_DIR/nino-$stamp.db"

  if command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "$DB_PATH" ".backup '$backup_path'"
  else
    cp "$DB_PATH" "$backup_path"
  fi

  echo "Backup created: $backup_path"
}

backups() {
  ensure_dirs
  find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.db' -print | sort
}

restore() {
  local source_path="${1:-}"
  if [[ -z "$source_path" ]]; then
    echo "Usage: scripts/ninoctl restore <backup.db>" >&2
    return 2
  fi
  if [[ ! -f "$source_path" ]]; then
    echo "Backup not found: $source_path" >&2
    return 1
  fi
  if pid_is_running || server_responds; then
    echo "Stop NIÑO before restoring a database." >&2
    return 1
  fi

  ensure_dirs
  if [[ -f "$DB_PATH" ]]; then
    local stamp pre_restore
    stamp="$(date +%Y%m%d-%H%M%S)"
    pre_restore="$BACKUP_DIR/pre-restore-$stamp.db"
    cp "$DB_PATH" "$pre_restore"
    echo "Current database saved: $pre_restore"
  fi
  cp "$source_path" "$DB_PATH"
  echo "Database restored from: $source_path"
}

doctor() {
  echo "== status =="
  status
  echo
  echo "== health =="
  request "/health" || true
  echo "== mode =="
  request "/operations/mode" || true
  echo "== claude =="
  request "/operations/claude" || true
  echo "== agents =="
  request "/agents" || true
  echo "== snapshot =="
  request "/development/snapshot" || true
  echo "== nino llm =="
  request "/agents/nino/llm/status" || true
}

readiness() {
  "$ROOT_DIR/scripts/nino-readiness"
}

product_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --skip-http --json
}

server_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --json
}

persistent_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-launchd --json
}

live_audit() {
  "$ROOT_DIR/scripts/nino-product-audit" --require-claude-live --json
}

command="${1:-}"
shift || true

case "$command" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) status ;;
  health) request "/health" ;;
  deep-health) request "/health/deep" ;;
  mode) request "/operations/mode" ;;
  claude) request "/operations/claude" ;;
  agents) request "/agents" ;;
  snapshot) request "/development/snapshot" ;;
  doctor) doctor ;;
  readiness) readiness ;;
  audit) product_audit ;;
  server-audit) server_audit ;;
  persistent-audit) persistent_audit ;;
  live-audit) live_audit ;;
  logs) logs "${1:-}" ;;
  backup) backup ;;
  backups) backups ;;
  restore) restore "${1:-}" ;;
  -h|--help|help|"") usage ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
