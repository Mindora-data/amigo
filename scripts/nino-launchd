#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT_DIR="${NINO_ROOT_DIR:-$SCRIPT_ROOT}"
ENV_FILE="${NINO_ENV_FILE:-$ROOT_DIR/.env.local}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi
LABEL="${NINO_LAUNCHD_LABEL:-local.nino.server}"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DEFAULT_PYTHON="$ROOT_DIR/.venv/bin/python"
if [[ -x "$DEFAULT_PYTHON" ]]; then
  PYTHON_BIN="${NINO_PYTHON:-$DEFAULT_PYTHON}"
else
  PYTHON_BIN="${NINO_PYTHON:-$(command -v python3)}"
fi
DB_PATH="${NINO_DB_PATH:-$ROOT_DIR/data/nino.db}"
HOST="${NINO_HOST:-127.0.0.1}"
PORT="${NINO_PORT:-8000}"
SCHEDULER_INTERVAL="${NINO_SCHEDULER_INTERVAL:-60}"
LOG_FILE="${NINO_LOG_FILE:-$ROOT_DIR/data/nino-launchd.log}"
ERR_FILE="${NINO_ERR_FILE:-$ROOT_DIR/data/nino-launchd.err.log}"

usage() {
  cat <<EOF
Usage: scripts/nino-launchd <command>

Commands:
  install    Install and start NIÑO as a macOS user service.
  uninstall  Stop and remove the user service.
  start      Start the installed service.
  stop       Stop the installed service.
  status     Show launchd status.
  doctor     Show launchd config, status and recent permission errors.
  print      Print the generated plist path.
  run        Internal launchd entrypoint.

Local env:
  By default scripts/nino-launchd loads $ROOT_DIR/.env.local when it exists.
EOF
}

protected_path_hint() {
  case "$ROOT_DIR" in
    "$HOME/Desktop"/*|"$HOME/Documents"/*|"$HOME/Downloads"/*)
      cat <<EOF
Warning: NIÑO is installed under a macOS privacy-protected folder:
  $ROOT_DIR
launchd may fail with "Operation not permitted" unless Terminal/launchd has
permission or the project is moved to a non-protected folder such as
  $HOME/Developer/bebe
EOF
      ;;
  esac
}

install() {
  mkdir -p "$HOME/Library/LaunchAgents" "$ROOT_DIR/data"
  protected_path_hint >&2
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>WorkingDirectory</key>
  <string>$ROOT_DIR</string>
  <key>ProgramArguments</key>
  <array>
    <string>$ROOT_DIR/scripts/nino-launchd</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NINO_ENV_FILE</key>
    <string>$ENV_FILE</string>
    <key>NINO_PYTHON</key>
    <string>$PYTHON_BIN</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$LOG_FILE</string>
  <key>StandardErrorPath</key>
  <string>$ERR_FILE</string>
</dict>
</plist>
EOF
  launchctl unload "$PLIST" >/dev/null 2>&1 || true
  launchctl load "$PLIST"
  echo "Installed: $PLIST"
}

run() {
  mkdir -p "$ROOT_DIR/data"
  cd "$ROOT_DIR"
  export PYTHONPATH="$ROOT_DIR/src"
  exec "$PYTHON_BIN" -m nino.server \
    --db "$DB_PATH" \
    --host "$HOST" \
    --port "$PORT" \
    --scheduler-interval "$SCHEDULER_INTERVAL"
}

uninstall() {
  launchctl unload "$PLIST" >/dev/null 2>&1 || true
  rm -f "$PLIST"
  echo "Removed: $PLIST"
}

status() {
  echo "label: $LABEL"
  echo "plist: $PLIST"
  echo "root: $ROOT_DIR"
  echo "log: $LOG_FILE"
  echo "err: $ERR_FILE"
  if ! launchctl list "$LABEL"; then
    echo "launchctl list did not return job details; trying launchctl print."
    launchctl print "gui/$(id -u)/$LABEL" || true
  fi
}

doctor() {
  status || true
  echo
  protected_path_hint || true
  echo
  if [[ -f "$ERR_FILE" ]]; then
    echo "== recent stderr =="
    tail -40 "$ERR_FILE"
  else
    echo "No stderr log yet: $ERR_FILE"
  fi
  echo
  if [[ -f "$LOG_FILE" ]]; then
    echo "== recent stdout =="
    tail -20 "$LOG_FILE"
  else
    echo "No stdout log yet: $LOG_FILE"
  fi
}

case "${1:-}" in
  install) install ;;
  uninstall) uninstall ;;
  start) launchctl load "$PLIST" ;;
  stop) launchctl unload "$PLIST" ;;
  status) status ;;
  doctor) doctor ;;
  print) echo "$PLIST" ;;
  run) run ;;
  -h|--help|help|"") usage ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    usage >&2
    exit 2
    ;;
esac
