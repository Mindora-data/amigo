#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path
import stat
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from nino.auth import hash_password


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Configure the single-user production password.")
    parser.add_argument("--password-stdin", action="store_true", help="Read password from stdin.")
    parser.add_argument("--env-file", default=str(ROOT / ".env.local"), help="Env file to update.")
    return parser.parse_args()


def update_env(path: Path, key: str, value: str) -> None:
    lines = path.read_text().splitlines() if path.exists() else []
    prefix = f"{key}="
    output = [line for line in lines if not line.startswith(prefix)]
    output.append(f"{key}={value}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(output) + "\n")
    path.chmod(stat.S_IRUSR | stat.S_IWUSR)


def main() -> int:
    args = parse_args()
    if not args.password_stdin:
        print("Use --password-stdin so the password is not stored in shell history.", file=sys.stderr)
        return 2
    password = sys.stdin.read().strip()
    if len(password) < 12:
        print("Password must be at least 12 characters.", file=sys.stderr)
        return 2
    update_env(Path(args.env_file), "NINO_PASSWORD_HASH", hash_password(password))
    print(f"Password hash written to {args.env_file}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
